@prefix : <http://cmt#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:r2rml:SE-Author> a rr:TriplesMap ;
    rr:logicalTable [ a rr:R2RMLView ;
            rr:sqlQuery "SELECT * FROM \"cmt_denormalized\".\"Author\"" ] ;
    rr:subjectMap [ a rr:SubjectMap,
                rr:TermMap ;
            rr:class :Author ;
            rr:template "http://cmt#Person/{ID}" ;
            rr:termType rr:IRI ] .

<urn:r2rml:SE-Bid> a rr:TriplesMap ;
    rr:logicalTable [ a rr:R2RMLView ;
            rr:sqlQuery "SELECT * FROM \"cmt_denormalized\".\"Bid\"" ] ;
    rr:subjectMap [ a rr:SubjectMap,
                rr:TermMap ;
            rr:class :Bid ;
            rr:template "http://cmt#Bid/{ID}" ;
            rr:termType rr:IRI ] .

<urn:r2rml:SE-Conference> a rr:TriplesMap ;
    rr:logicalTable [ a rr:R2RMLView ;
            rr:sqlQuery "SELECT * FROM \"cmt_denormalized\".\"Conference\"" ] ;
    rr:predicateObjectMap [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "reviewsPerPaper" ;
                    rr:datatype xsd:int ;
                    rr:termType rr:Literal ] ;
            rr:predicate :reviewsPerPaper ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "date" ;
                    rr:datatype xsd:date ;
                    rr:termType rr:Literal ] ;
            rr:predicate :date ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "siteURL" ;
                    rr:datatype xsd:anyURI ;
                    rr:termType rr:Literal ] ;
            rr:predicate :siteURL ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "name" ;
                    rr:datatype xsd:string ;
                    rr:termType rr:Literal ] ;
            rr:predicate :name ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "logoURL" ;
                    rr:datatype xsd:anyURI ;
                    rr:termType rr:Literal ] ;
            rr:predicate :logoURL ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap,
                        rr:TermMap ;
                    rr:column "acceptsHardcopySubmissions" ;
                    rr:datatype xsd:boolean ;
                    rr:termType rr:Literal ] ;
            rr:predicate :acceptsHardcopySubmissions ] ;
    rr:subjectMap [ a rr:SubjectMap,
                rr:TermMap ;
            rr:class :Conference ;
            rr:template "http://cmt#Conference/{ID}" ;
            rr:termType rr:IRI ] .

