[PrefixDeclaration]
:		http://cmt#
rr:		http://www.w3.org/ns/r2rml#
xsd:		http://www.w3.org/2001/XMLSchema#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
owl:		http://www.w3.org/2002/07/owl#
obda:		https://w3id.org/obda/vocabulary#

[MappingDeclaration] @collection [[
mappingId	mapping-855603720
target		:Bid/{ID} a :Bid . 
source		SELECT * FROM "cmt_denormalized"."Bid"

mappingId	mapping--1580032512
target		:Person/{ID} a :ProgramCommitteeMember ; :maxPapers {maxPapers}^^xsd:int . 
source		SELECT * FROM "cmt_denormalized"."ProgramCommitteeMember"

mappingId	mapping--1306173710
target		:Decision/{ID} a :Rejection . 
source		SELECT * FROM "cmt_denormalized"."Rejection"

mappingId	mapping--505710011
target		:ProgramCommittee/{ID} a :ProgramCommittee . 
source		SELECT * FROM "cmt_denormalized"."ProgramCommittee"

mappingId	mapping--59512420
target		:Person/{ID} a :Author . 
source		SELECT * FROM "cmt_denormalized"."Author"

mappingId	mapping-707763419
target		:Person/{ID} a :ProgramCommitteeChair . 
source		SELECT * FROM "cmt_denormalized"."ProgramCommitteeChair"

mappingId	mapping--1699350116
target		:Person/{ID} a :User . 
source		SELECT * FROM "cmt_denormalized"."User"

mappingId	mapping--1137417047
target		:SubjectArea/{ID} a :SubjectArea . 
source		SELECT * FROM "cmt_denormalized"."SubjectArea"

mappingId	mapping-2092672375
target		:Person/{ID} a :Person ; :email {email}^^xsd:string ; :name {name}^^xsd:string . 
source		SELECT * FROM "cmt_denormalized"."Person"

mappingId	mapping-133763516
target		:Preference/{ID} a :Preference . 
source		SELECT * FROM "cmt_denormalized"."Preference"

mappingId	mapping--904031167
target		:Document/{ID} a :Document . 
source		SELECT * FROM "cmt_denormalized"."Document"

mappingId	mapping--2111838630
target		:Conference/{ID} a :Conference ; :date {date}^^xsd:date ; :acceptsHardcopySubmissions {acceptsHardcopySubmissions}^^xsd:boolean ; :reviewsPerPaper {reviewsPerPaper}^^xsd:int ; :logoURL {logoURL}^^xsd:anyURI ; :name {name}^^xsd:string ; :siteURL {siteURL}^^xsd:anyURI . 
source		SELECT * FROM "cmt_denormalized"."Conference"
]]

